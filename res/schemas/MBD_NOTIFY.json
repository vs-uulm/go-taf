{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$wrapper": "https://connect.informatik.uni-ulm.de/coordination/taf-implementation/-/tree/main/TAF_External_Interfaces/Messaging/GENERIC_SUBSCRIPTION_NOTIFY/",
    "$id": "https://connect.informatik.uni-ulm.de/coordination/taf-implementation/-/tree/main/TAF_External_Interfaces/Messaging/MBD_NOTIFY/",
    "title": "MBD_NOTIFY",
    "type": "object",
    "properties": {
      "subscriptionId": {
        "type": "string",
        "@origin": "@subscribe#subscriptionId"
      },
      "CPM_REPORT": {
        "type": "object",
        "properties": {
          "generationTime": {
            "type": "number"
          },
          "reporterPseudoId": {
            "type": "number"
          },
          "reporterArteryId": {
            "type": "number"
          },
          "version": {
            "type": "number"
          },
          "observationlocation": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "content": {
            "type": "object",
            "properties": {
              "observationSet": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "targetId": {
                      "type": "number"
                    },
                     "check": {
                       "type": "number"
                    },
                    "relative_position_error_x": {
                      "type": "number"
                    },
                    "relative_position_error_y": {
                      "type": "number"
                    },
                    "sender_speed_error_x": {
                      "type": "number"
                    },
                    "sender_speed_error_y": {
                      "type": "number"
                    },
                    "sender_acceleration_error_x": {
                      "type": "number"
                    },
                    "sender_acceleration_error_y": {
                      "type": "number"
                    },
                    "distance_to_road_edge_error": {
                      "type": "number"
                    },
                    "receiver_time_error": {
                      "type": "number"
                    },
                    "sender_heading_error_sin": {
                      "type": "number"
                    },
                    "sender_heading_error_cos": {
                      "type": "number"
                    }
                  },
                  "required": [ "targetId" ],
                  "oneOf": [{
                    "required": [ "check" ],
                    "not": {
                      "anyOf": [
                        { "required": [ "relative_position_error_x" ] },
                        { "required": [ "relative_position_error_y" ] },
                        { "required": [ "sender_speed_error_x" ] },
                        { "required": [ "sender_speed_error_y" ] },
                        { "required": [ "sender_acceleration_error_x" ] },
                        { "required": [ "sender_acceleration_error_y" ] },
                        { "required": [ "distance_to_road_edge_error" ] },
                        { "required": [ "receiver_time_error" ] },
                        { "required": [ "sender_heading_error_sin" ] },
                        { "required": [ "sender_heading_error_cos" ] }
                      ]
                    }
                  }, {
                    "required": [
                      "relative_position_error_x",
                      "relative_position_error_y",
                      "sender_speed_error_x",
                      "sender_speed_error_y",
                      "sender_acceleration_error_x",
                      "sender_acceleration_error_y",
                      "distance_to_road_edge_error",
                      "receiver_time_error",
                      "sender_heading_error_sin",
                      "sender_heading_error_cos"
                    ],
                    "not": {
                      "anyOf": [
                        { "required": [ "check" ] }
                      ]
                    }
                  }]
                }
              },
              "V2XPduEvidence": {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": "number"
                  },
                  "referenceTime": {
                    "type": "number"
                  }
                },
                "required": [
                  "sourceId",
                  "referenceTime"
                ]
              }
            },
            "required": [
              "observationSet",
              "V2XPduEvidence"
            ]
          }
        },
        "required": [
          "generationTime",
          "reporterPseudoId",
          "reporterArteryId",
          "version",
          "observationlocation",
          "content"
        ]
      },
      "tag" : {
        "description": "Unique identifier for this message.",
        "type": "string"
      }
    },
    "required": [
      "subscriptionId",
      "CPM_REPORT"
    ],
    "$priorMessages": {
      "subscribe": "https://connect.informatik.uni-ulm.de/coordination/taf-implementation/-/raw/main/TAF_External_Interfaces/Messaging/MBD_SUBSCRIBE_RESPONSE/"
    }
  }
